{
  "name": "angular-blog-app",
  "version": "0.0.0",
  "scripts": {
    "start:web": "ng serve web --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "start:web:local-env": "ng serve web --configuration=local-env --port 4200",
    "start:admin:local-env": "ng serve admin --configuration=local-env --port 4201",
    "start:local:backend": "npx supabase start",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "watch:web": "ng build web --watch --configuration development",
    "watch:admin": "ng build admin --watch --configuration development",
    "build": "ng build web",
    "build:admin": "ng build admin",
    "build:all": "ng build shared && ng build web && ng build admin && ng build code-samples-mfe",
    "test:web": "ng test web",
    "test:admin": "ng test admin",
    "test:shared": "ng test shared",
    "test:mfe": "ng test code-samples-mfe",
    "test:all": "run-s --continue-on-error \"test:web -- --browsers=ChromeHeadless --watch=false --no-progress\" \"test:admin -- --browsers=ChromeHeadless --watch=false --no-progress\" \"test:shared -- --browsers=ChromeHeadless --watch=false --no-progress\" \"test:mfe -- --browsers=ChromeHeadless --watch=false --no-progress\"",
    "e2e": "playwright test",
    "e2e:web": "playwright test --project=web",
    "e2e:admin": "playwright test --project=admin",
    "lint:web": "ng lint web",
    "lint:web:fix": "ng lint web --fix",
    "lint:admin": "ng lint admin",
    "lint:admin:fix": "ng lint admin --fix",
    "lint:mfe": "ng lint code-samples-mfe",
    "lint:mfe:fix": "ng lint code-samples-mfe --fix",
    "lint:shared": "ng lint shared",
    "lint:shared:fix": "ng lint shared --fix",
    "lint:all": "run-s --continue-on-error lint:web lint:admin lint:mfe lint:shared",
    "lint:all:fix": "run-s --continue-on-error lint:web:fix lint:admin:fix lint:mfe:fix lint:shared:fix",
    "lint:styles": "stylelint \"projects/**/*.css\"",
    "lint:styles:fix": "stylelint \"projects/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:createSeed": "tsx scripts/create-seed.ts",
    "db:seed": "npm run db:createSeed && npx supabase db reset",
    "schema:pull": "find supabase/migrations -name '*_remote_schema.sql' -delete && npx supabase db pull --db-url $PG_EXPORT_URL",
    "password:reset": "tsx scripts/reset-password.ts",
    "routes:generate": "tsx scripts/generate-routes.ts",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.7",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.1.7",
    "@angular/compiler": "^20.1.7",
    "@angular/core": "^20.1.7",
    "@angular/forms": "^20.1.7",
    "@angular/platform-browser": "^20.1.7",
    "@angular/platform-browser-dynamic": "^20.1.7",
    "@angular/platform-server": "^20.1.7",
    "@angular/router": "^20.1.7",
    "@angular/ssr": "^20.1.6",
    "@ng-icons/core": "^32.1.0",
    "@ng-icons/lucide": "^32.1.0",
    "@ngrx/operators": "^20.0.0",
    "@ngrx/signals": "^20.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "ngx-highlightjs": "^12.0.0",
    "ngx-quill": "^28.0.1",
    "quill": "^2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.6",
    "@angular/cli": "^20.1.6",
    "@angular/compiler-cli": "^20.1.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.1.0",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.4.38",
    "prettier": "3.4.2",
    "stylelint": "^17.14.1",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.34.1"
  }
}
